# Dados brutos e intermediários (grandes — não vão para o GitHub)
data/raw/*
data/trimmed/*
data/sra/*
data/reference/*
!data/raw/.gitkeep
!data/trimmed/.gitkeep
!data/sra/.gitkeep
!data/reference/.gitkeep
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.sralite
*.fa
*.fna
*.fasta
*.fa.gz
*.fna.gz
# FASTAs pequenos da aula/exercício de alinhamento (estes vão para o GitHub)
!alinhamento/**/*.fasta

# Material privado do professor (roteiro, gabarito, soluções)
privado/

# Resultados pesados de montagem / QC / alinhamento
results/assembly/*
results/quast/*
results/qc/raw/*
results/qc/trimmed/*
results/align/*
results/busco/
results/blast/
results/alinhamento/
!results/assembly/.gitkeep
!results/quast/.gitkeep
!results/qc/raw/.gitkeep
!results/qc/trimmed/.gitkeep
!results/align/.gitkeep
*.bam
*.bai
*.sam
*.bwt
*.pac
*.ann
*.amb
*.sa
*.mmi

# Conda / cache local
.snakemake/
__pycache__/
*.pyc
.DS_Store

# Relatórios locais opcionais
*.log
nohup.out
